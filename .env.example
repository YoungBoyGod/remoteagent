# RemoteAgent 必填环境变量（不含真实值）
# 复制为 .env 并填写实际值

# ── Server ──
SERVER_REGISTER_TOKEN=
SERVER_DB_PASSWORD=
SERVER_DB_HOST=localhost
SERVER_DB_PORT=25432
SERVER_DB_USER=remotegpu_user
SERVER_DB_NAME=remotegpu

# ── S3/MinIO ──
S3_ENDPOINT=http://localhost:29000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Redis ──
REDIS_ADDR=localhost:26379

# ── Agent ──
AGENT_SERVER_ADDR=http://127.0.0.1:40001
AGENT_REGISTER_TOKEN=
AGENT_DEVICE_CODE=
