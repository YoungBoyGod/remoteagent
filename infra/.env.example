# ============================================================
# RemoteAgent 基础设施环境变量
# 复制此文件为 .env 并修改配置
# ============================================================

# ── PostgreSQL ──
DB_USER=remoteagent_user
DB_PASSWORD=remoteagent_password
DB_NAME=remoteagent_db
DB_PORT=25432

# ── Redis ──
REDIS_PORT=26379

# ── MeiliSearch ──
MEILI_MASTER_KEY=meili-dev-key
MEILI_ENV=development
MEILI_PORT=27700

# ── MinIO (S3 兼容存储) ──
MINIO_ROOT_USER=rustfs
MINIO_ROOT_PASSWORD=rustfs
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001

# ── Prometheus & Grafana ──
PROMETHEUS_PORT=29090
GRAFANA_PORT=23000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
