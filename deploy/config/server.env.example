# ============================================================
# Server + Frontend 部署环境变量配置
# 复制此文件为 server.env 并修改实际值
# ============================================================

# ============================================================
# 基础配置
# ============================================================
SERVER_ADDR=:40001
SERVER_REGISTER_TOKEN=your-secure-register-token
SERVER_JWT_TTL_SECONDS=86400
SERVER_POLL_TIMEOUT_SECONDS=30
# 生产环境应设为 false 禁用 Swagger API 文档
SERVER_ENABLE_SWAGGER=false

# ============================================================
# 数据库配置 (PostgreSQL)
# ============================================================
# 如果使用独立的 Infra，修改为 Infra 服务器的地址
SERVER_DB_HOST=infra-server-ip
SERVER_DB_PORT=25432
SERVER_DB_USER=remotegpu_user
SERVER_DB_PASSWORD=your-secure-db-password
SERVER_DB_NAME=remotegpu
# 生产环境应设为 require 或 verify-full
SERVER_DB_SSLMODE=disable
SERVER_DB_CONNECT_TIMEOUT_SECONDS=5

# ============================================================
# Redis 配置
# ============================================================
# 如果使用独立的 Infra，修改为 Infra 服务器的地址
REDIS_ADDR=infra-server-ip:26379
# 生产环境必须设置强密码
REDIS_PASSWORD=
REDIS_DB=0



# ============================================================
# 日志配置
# ============================================================
SERVER_LOG_TO_STDOUT=true
SERVER_LOG_FILE_PATH=/var/log/remoteagent/server.log

# ============================================================
# S3/MinIO 配置 (文件存储)
# ============================================================
# 如果使用独立的 Infra，修改为 Infra 服务器的地址
S3_ENDPOINT=http://infra-server-ip:29000
S3_REGION=us-east-1
S3_BUCKET=doccenter
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=your-secure-minio-password
S3_USE_PATH_STYLE=true

# ============================================================
# 前端配置 (构建时注入)
# ============================================================
VITE_API_BASE_URL=http://server-ip:40001
VITE_WS_BASE_URL=ws://server-ip:40001
