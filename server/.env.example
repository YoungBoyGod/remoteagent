SERVER_ADDR=:40001
SERVER_REGISTER_TOKEN=<your-register-token>
SERVER_JWT_TTL_SECONDS=86400
SERVER_POLL_TIMEOUT_SECONDS=30
SERVER_DB_HOST=127.0.0.1
SERVER_DB_PORT=5432
SERVER_DB_USER=<db-user>
SERVER_DB_PASSWORD=<db-password>
SERVER_DB_NAME=<db-name>
SERVER_DB_SSLMODE=require
SERVER_DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0
S3_ENDPOINT=https://<s3-endpoint>
S3_REGION=us-east-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_USE_PATH_STYLE=false
SERVER_LOG_TO_STDOUT=true
SERVER_LOG_DIR=./logs/server
# 生产环境必须设为 false
SERVER_ENABLE_SWAGGER=false
